# Example Nginx reverse proxy in front of Gunicorn (deploy/run_gunicorn.sh,
# listening on 127.0.0.1:8000). Get a real cert first — e.g. `certbot --nginx`
# (Let's Encrypt) — then this config just proxies everything to Django.
#
# Streaming (/api/chat/stream/) needs proxy_buffering off, or Nginx will
# buffer the whole SSE response before sending anything to the browser,
# defeating the point of streaming.

server {
    listen 80;
    server_name chatbot.onmascout.de;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name chatbot.onmascout.de;

    ssl_certificate     /etc/letsencrypt/live/chatbot.onmascout.de/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/chatbot.onmascout.de/privkey.pem;

    location /api/chat/stream/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding off;
        proxy_read_timeout 90s;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
