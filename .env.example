DJANGO_SECRET_KEY=replace-with-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=

# Dev default: SQLite, zero setup. Production should use Postgres — SQLite
# doesn't handle concurrent writes well under a real multi-worker WSGI
# server. Uncomment and fill in to switch (needs a real Postgres server —
# `pip install "psycopg[binary]"` is already in requirements.txt):
# DATABASE_ENGINE=postgresql
# DB_NAME=onma_chatbot
# DB_USER=onma_chatbot
# DB_PASSWORD=replace-with-a-real-password
# DB_HOST=localhost
# DB_PORT=5432

# Production-only hardening — all off by default so local HTTP dev keeps
# working. Flip these (and run `manage.py check --deploy`) before a real
# TLS deployment. See README's "Security + GDPR hardening" section.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False

# Production default: OpenAI directly.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_API_KEY=replace-with-real-key

# For testing without an OpenAI billing setup, OpenRouter works as a drop-in
# replacement (verified: chat, streaming, and embeddings all confirmed
# working) — no code changes needed, bot/llm.py only reads these settings.
# Swap in place of the four lines above:
#   LLM_PROVIDER=openrouter
#   LLM_MODEL=openai/gpt-4o-mini
#   LLM_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
#   LLM_API_KEY=replace-with-your-openrouter-key
# ...and EMBEDDING_MODEL/EMBEDDING_ENDPOINT below to:
#   EMBEDDING_MODEL=openai/text-embedding-3-small
#   EMBEDDING_ENDPOINT=https://openrouter.ai/api/v1/embeddings
# Reindex after switching providers — embeddings from different
# providers/models aren't comparable for similarity search.

CHAT_MAX_MESSAGE_LENGTH=1000
CHAT_RATE_LIMIT_PER_MINUTE=12

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_ENDPOINT=https://api.openai.com/v1/embeddings
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.15

# Dev default prints emails to the console. Set real SMTP_* values and
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend for real delivery.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=noreply@onmascout.local
SALES_NOTIFICATION_EMAIL=sales@onmascout.local

# GDPR retention window for manage.py purge_old_data (days).
RETENTION_DAYS=90

# Cloudflare Turnstile — blank = disabled (default). Sign up at
# https://dash.cloudflare.com/?to=/:account/turnstile for real keys, or use
# Cloudflare's published test keys during development:
#   pass: site=1x00000000000000000000BB secret=1x0000000000000000000000000000000AA
#   fail: site=2x00000000000000000000BB secret=2x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_FAIL_OPEN=True
